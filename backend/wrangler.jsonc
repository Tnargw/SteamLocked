{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steamlocked",
  "main": "src/index.js",
  // Keep at or below the date the pinned workerd binary supports, otherwise
  // `vitest` (which runs tests inside workerd) refuses to start.
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  }
}
